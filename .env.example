# Flask settings
FLASK_APP=wsgi.py
APP_SETTINGS=server.config.DevelopmentConfig

# Security (generate strong random values for production)
SECRET_KEY="change-me-to-a-long-random-string"
SECURITY_PASSWORD_SALT="change-me-to-a-long-random-string"

# PostgreSQL (replace with your actual connection string)
DATABASE_URL="postgresql://<username>:<password>@localhost:5432/financial_dashboard"

# Redis (used for JWT token blacklist and caching)
REDIS_URL="redis://127.0.0.1:6379"

# Email / SMTP (Gmail example; set MAIL_USE_TLS=True and MAIL_USE_SSL=False for port 587)
MAIL_SERVER="smtp.googlemail.com"
MAIL_PORT=465
MAIL_USERNAME="sender@gmail.com"
MAIL_PASSWORD="your-app-password"

# Financial data APIs
ALPHA_VANTAGE_API_KEY=""       # https://www.alphavantage.co/support/#api-key (free tier: 5 req/min)
IEX_TOKEN=""                    # https://iexcloud.io (sandbox is free)
IEX_BASE_URL="https://sandbox.iexapis.com/"

# MongoDB Atlas (for ticker search). Leave blank to disable ticker search.
MONGO_DB_CONNECTION_STRING=""

# Frontend URL (used in email links)
FINANCIAL_DASHBOARD_FE_URL="http://127.0.0.1:8080"

# Set to 1 in production so Flask serves the built Vue SPA.
# Requires `npm run build` to be run first.
SHOULD_PROXY="0"

# Vue dev server API base (used when SHOULD_PROXY=0)
VUE_APP_API_URL="http://127.0.0.1:5000/api"
